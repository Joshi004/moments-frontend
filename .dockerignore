# ============================================================
# moments-frontend/.dockerignore
# Prevents large/sensitive directories from entering the
# Docker build context. The build stage installs its own
# node_modules via npm ci.
# ============================================================

# Dependencies — reinstalled inside the image via npm ci
node_modules/

# Previous build output — rebuilt inside the image via npm run build
build/

# Git
.git/
.gitignore

# Environment / secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Documentation
*.md

# IDE
.cursor/
.vscode/

# macOS
.DS_Store

# npm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
